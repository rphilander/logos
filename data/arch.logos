(define arch-modules (dict :symbol "arch-modules" :name "Modules" :description "Microkernel module system. External OS processes connect over unix domain sockets, discover themselves via a handshake (core sends empty request, module responds with name + manual), and are registered in the modules map. The send builtin lets logos code call module operations during eval — it serializes requests to JSON, writes to the module socket, reads the response, and records the exchange in the active trace. Modules can also call back to core via the callback socket, which routes through the actor loop to evaluate an on-request handler. Per-module mutex serializes socket reads/writes." :keywords (list "module" "send" "socket" "handshake" "discovery" "callback" "ModuleInfo" "microkernel" "external process" "JSON") :anchors (list anchor-module-info anchor-handle-module-connection anchor-builtin-send anchor-handle-callback) :interactions (list) :see-also (list (link 'arch-core-api) (link 'arch-evaluator) (link 'arch-traces) (link 'arch-types))))

(define anchor-load-libraries (dict :symbol "anchor-load-libraries" :name "loadLibraries" :file "core/graph.go" :scope "Graph.loadLibraries" :hash "sha256:bef6ac95b47380013c318e09a37a4499e7d90faf9321daa590e79662a2d71a81" :commit "78012b0" :description "Reads manifest and replays all library files in order into the graph at startup."))

(define anchor-library-create (dict :symbol "anchor-library-create" :name "LibraryCreate" :file "core/graph.go" :scope "Graph.LibraryCreate" :hash "sha256:144fb0eea5549f6926cf1343b8a559b66c0cdedbde6e5afd14f5b5f466fdda1c" :commit "78012b0" :description "Creates empty library file and adds name to manifest."))

(define anchor-library-open (dict :symbol "anchor-library-open" :name "LibraryOpen" :file "core/graph.go" :scope "Graph.LibraryOpen" :hash "sha256:e372716693462075d2e2e8e5ce2ce4c9bbbeba5b6b14a4d752218c0ec2135dd4" :commit "78012b0" :description "Opens library file for writing, closes session log, switches activeLib context."))

