(define arch-step-debugger (dict :symbol "arch-step-debugger" :name "Step Debugger" :description "Serialization layer atop the frame-based evaluator enabling single-step execution. builtinStepEval parses an expression and returns the initial evalState as a logos map. builtinStepContinue deserializes a state map, runs one evalStep, and re-serializes the result. The serialization layer (frameToValue/valueToFrame, evalStateToValue/valueToEvalState) handles all 14 frame kinds with their variant-specific fields. Frame bindings are reconnected to shared scope maps after deserialization to maintain the evaluator's invariant. State maps expose :status (:evaluating/:returning/:done/:error) for external inspection." :keywords (list "step" "debugger" "step-eval" "step-continue" "serialize" "deserialize" "frame" "evalState" "suspend" "resume" "single-step") :anchors (list anchor-builtin-step-eval anchor-builtin-step-continue anchor-frame-to-value anchor-value-to-frame anchor-eval-state-to-value anchor-value-to-eval-state) :interactions (list arch-eval-step-debugger-interaction) :see-also (list (link 'arch-evaluator) (link 'arch-parser) (link 'arch-core-api) (link 'lang-builtin-step-eval))))

