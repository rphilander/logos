(define anchor-evaluator (dict :symbol "anchor-evaluator" :name "Evaluator" :file "core/eval.go" :scope "Evaluator" :hash "sha256:4193317b9b7489a3ba20d5e39d52485788666dba22f920bdcd747303d50b5e32" :commit "78012b0" :description "Central evaluator struct: ResolveNode/ResolveAST function pointers, Builtins map, locals stack, currentNodeID, Fuel counter, activeTrace."))

(define anchor-eval-step (dict :symbol "anchor-eval-step" :name "evalStep" :file "core/eval.go" :scope "Evaluator.evalStep" :hash "sha256:f60f0b7c465ba26837b481671fcbfd93a72b560d599fa9fa5bfb3d1343c95d5d" :commit "78012b0" :description "Single evaluation iteration — the core state machine. Processes fuel, dispatches on node kind, manages frame stack transitions."))

(define anchor-eval-loop (dict :symbol "anchor-eval-loop" :name "evalLoop" :file "core/eval.go" :scope "Evaluator.evalLoop" :hash "sha256:d68ab821392b603d21a83bf211b3e86595abfe7a7f5ac14eced9794d33b22aac" :commit "78012b0" :description "Main iterative evaluation loop wrapper."))

(define anchor-eval-loop-with (dict :symbol "anchor-eval-loop-with" :name "evalLoopWith" :file "core/eval.go" :scope "Evaluator.evalLoopWith" :hash "sha256:4eed01888a29c718148744b35842dbdd1f1b15a5292df4a7389225d44eca24b8" :commit "78012b0" :description "Eval loop with optional pre-seeded stack. Provides re-entrant safety by saving/restoring locals and currentNodeID."))

(define anchor-frame (dict :symbol "anchor-frame" :name "frame" :file "core/eval.go" :scope "frame" :hash "sha256:11916f3abdf07669c942d469daa02f989a427ba9412ab7feb7c3ff3bb4bf8cc6" :commit "78012b0" :description "Evaluation stack frame struct. 14 frame kinds encode evaluation context: fn body, scope cleanup, node ref, eval head, builtin/fn args, if cond, let/loop bindings, do sequence, form expansion, apply, loop body, recur args."))

(define anchor-eval-state (dict :symbol "anchor-eval-state" :name "evalState" :file "core/eval.go" :scope "evalState" :hash "sha256:b8780e2f6f92e029a3e9dea8f49ddfc799b9962b6f8156a39d321445ab770382" :commit "78012b0" :description "Serializable snapshot of evaluation in progress: current node, phase, result value, frame stack, error."))

(define anchor-enter-fn-body (dict :symbol "anchor-enter-fn-body" :name "enterFnBody" :file "core/eval.go" :scope "Evaluator.enterFnBody" :hash "sha256:2b700e208e2e1e6e3f5fee5d791bc4aba7eff9547693ff85ce05f909932ea173" :commit "78012b0" :description "Function call setup: pushes closure scope, binds parameters, creates frameFnBody for cleanup, returns body node."))

(define anchor-handle-form-call (dict :symbol "anchor-handle-form-call" :name "handleFormCall" :file "core/eval.go" :scope "Evaluator.handleFormCall" :hash "sha256:835172f8c074ffdeb31beb8f72f87bb87ce5b891091040763ab93c23a573f174" :commit "78012b0" :description "Form (macro) expansion: converts AST args to Values, calls form body via re-entrant CallFnWithValues, converts expansion back to AST."))

(define anchor-call-fn-with-values (dict :symbol "anchor-call-fn-with-values" :name "CallFnWithValues" :file "core/eval.go" :scope "Evaluator.CallFnWithValues" :hash "sha256:43fea24b6e90c56aba9c420c8859fae6cf18f46120a933f4ae937cb1dc5b8cea" :commit "78012b0" :description "Direct function call with pre-evaluated Values. Re-entrant: saves/restores locals and currentNodeID. Used by evalStep and handleFormCall."))

(define anchor-resolve-symbol (dict :symbol "anchor-resolve-symbol" :name "resolveSymbol" :file "core/eval.go" :scope "Evaluator.resolveSymbol" :hash "sha256:94c79601309896ecf7611db82be65023de87a37d96cec2353dcebf630839c9bd" :commit "78012b0" :description "Resolves a symbol name to a Value by looking up locals then falling back to ResolveNode for graph nodes."))

(define anchor-node-to-value (dict :symbol "anchor-node-to-value" :name "nodeToValue" :file "core/eval.go" :scope "nodeToValue" :hash "sha256:0a9705e48b7d029faf56323afc573d168548550a1c5c399af6ab8e2f4a029d72" :commit "78012b0" :description "Converts AST node to logos Value. Used by quote and form expansion."))

(define anchor-value-to-node (dict :symbol "anchor-value-to-node" :name "valueToNode" :file "core/eval.go" :scope "valueToNode" :hash "sha256:a37b5d579d968217e8842ea869aa09bd6785e21f58d7f2d788c64f2ca3c0da73" :commit "78012b0" :description "Converts logos Value back to AST node. Inverse of nodeToValue. Used by form expansion."))

(define anchor-eval-state-to-value (dict :symbol "anchor-eval-state-to-value" :name "evalStateToValue" :file "core/step.go" :scope "evalStateToValue" :hash "sha256:5f3fe70aee24e6372d3d6bf260cc8e34ed20a2fa02624d61ebd3d338a1221cf6" :commit "78012b0" :description "Serializes evalState, locals, nodeID, fuel to a logos map Value for step-debugger persistence."))

(define anchor-value-to-eval-state (dict :symbol "anchor-value-to-eval-state" :name "valueToEvalState" :file "core/step.go" :scope "valueToEvalState" :hash "sha256:e500df2e15bbdf06fb1b3a88139cae930626fff5ac7231e954e5d473d78f6b48" :commit "78012b0" :description "Deserializes logos map Value back to evalState, locals, nodeID, fuel. Reconnects frame bindings to shared scope."))

(define anchor-data-builtins (dict :symbol "anchor-data-builtins" :name "DataBuiltins" :file "core/eval.go" :scope "DataBuiltins" :hash "sha256:f617b824afac4cba974790ffe3588b64927b71b7ad5ff5d546adb463c05d7211" :commit "78012b0" :description "Returns the minimal data primitive builtins map. Populated into Evaluator.Builtins by Core."))

(define arch-eval-graph-interaction (dict :symbol "arch-eval-graph-interaction" :name "Evaluator ↔ Graph" :description "The evaluator resolves node references via ResolveNode on every NodeRef encountered in evalStep. At define time, the graph's resolveAST transforms symbols into NodeRef/NodeBuiltin before the evaluator sees them. The evaluator tracks currentNodeID for error attribution and trace context." :keywords (list "resolve" "node-ref" "ResolveNode" "ResolveAST" "currentNodeID" "symbol resolution" "define time") :anchors (list anchor-resolve-symbol) :concepts (list (link 'arch-evaluator) (link 'arch-graph))))

(define arch-eval-step-debugger-interaction (dict :symbol "arch-eval-step-debugger-interaction" :name "Evaluator ↔ Step Debugger" :description "The step debugger wraps evalStep to allow single-stepping through evaluation. evalState is serialized to/from logos Values via evalStateToValue and valueToEvalState, enabling suspended evaluation that persists across calls. Each frame kind has its own serialization logic." :keywords (list "step" "debugger" "serialize" "suspend" "resume" "evalState" "frame serialization" "step-eval" "step-continue") :anchors (list anchor-eval-state-to-value anchor-value-to-eval-state) :concepts (list (link 'arch-evaluator) (link 'arch-step-debugger))))

(define arch-eval-types-interaction (dict :symbol "arch-eval-types-interaction" :name "Evaluator ↔ Types" :description "The evaluator is the primary producer and consumer of Values. evalStep dispatches on node kind to produce typed Values (IntVal, BoolVal, etc.), uses Value.Truthy() for conditionals, and captures scope as map[string]Value for closures. nodeToValue/valueToNode provide round-trip AST conversion for quote and form expansion." :keywords (list "Value" "type dispatch" "Truthy" "closure" "scope" "nodeToValue" "valueToNode" "AST conversion" "quote" "form expansion") :anchors (list anchor-node-to-value anchor-value-to-node anchor-data-builtins) :concepts (list (link 'arch-evaluator) (link 'arch-types))))

(define arch-evaluator (dict :symbol "arch-evaluator" :name "Evaluator" :description "Frame-based iterative evaluator with no Go recursion. The core state machine (evalStep) processes one iteration per call: dispatches on AST node kind during the evaluation phase, then pops and processes stack frames during the value phase. 14 frame kinds encode all evaluation contexts — function calls, conditionals, let bindings, loop/recur, form expansion, apply, and sequential execution. The frame stack replaces the Go call stack, eliminating stack overflow risk and enabling the step debugger to suspend and resume evaluation. Re-entrant via CallFnWithValues for form expansion and sort-by." :keywords (list "evaluator" "eval" "frame" "stack" "iterative" "state machine" "evalStep" "evalLoop" "fuel" "re-entrant") :anchors (list anchor-evaluator anchor-eval-step anchor-eval-loop anchor-eval-loop-with anchor-frame anchor-eval-state anchor-enter-fn-body anchor-handle-form-call anchor-call-fn-with-values) :interactions (list arch-eval-graph-interaction arch-eval-step-debugger-interaction arch-eval-types-interaction) :see-also (list (link 'arch-parser) (link 'arch-libraries) (link 'arch-traces) (link 'lang-form-loop) (link 'lang-form-fn) (link 'lang-form-form) (link 'lang-form-if) (link 'lang-form-let) (link 'lang-concept-closures) (link 'lang-concept-iteration) (link 'lang-concept-define-time))))

(define anchor-graph (dict :symbol "anchor-graph" :name "Graph" :file "core/graph.go" :scope "Graph" :hash "sha256:9c5ec5a10d6c2984688a5c9c58f3c941c15838b2541579a8c87dd69fdae7efab" :commit "78012b0" :description "Central store: nodes map (ID → GraphNode), symbols map (name → node ID), symbolOwner (name → library), nameCounters, active library context, evaluator, log file handle."))

(define anchor-define (dict :symbol "anchor-define" :name "Define" :file "core/graph.go" :scope "Graph.Define" :hash "sha256:2cad5ad4a382acfa5ce1b665236ad3874b7066ac219a72e259e4d6b747836abb" :commit "78012b0" :description "Core symbol definition: parse, resolveAST, create unique node ID, store GraphNode with refs, update symbol map, log entry."))

(define anchor-resolve-ast (dict :symbol "anchor-resolve-ast" :name "resolveAST" :file "core/graph.go" :scope "Graph.resolveAST" :hash "sha256:94d9689073ca12be8af1a686d4f8076b27b0dd094ce688aa126d3646773779df" :commit "78012b0" :description "Traverses AST converting unbound symbols to NodeRef or NodeBuiltin. Tracks refs for dependency graph. Preserves bound names from let/fn/form params. Stops at quote."))

(define anchor-refresh-all (dict :symbol "anchor-refresh-all" :name "RefreshAll" :file "core/graph.go" :scope "Graph.RefreshAll" :hash "sha256:a2bddfc743f3a57b72f0e85a3b63befb0674221355d5af1fe6063dddefa6f27d" :commit "78012b0" :description "Re-resolves all dependents of target symbols via BFS. Re-parses, re-resolves, creates new nodes, updates symbol map, logs to owning library."))

(define anchor-make-node-id (dict :symbol "anchor-make-node-id" :name "makeNodeID" :file "core/graph.go" :scope "Graph.makeNodeID" :hash "sha256:814b236aea082f5040a9d48579eb4dee8455941747b6714dab8391dd960bdccd" :commit "78012b0" :description "Generates unique node ID: node:name-N (session) or node:lib/name-N (library). Enables immutable graph — old nodes never overwritten."))

(define anchor-ref (dict :symbol "anchor-ref" :name "Ref" :file "core/graph.go" :scope "Ref" :hash "sha256:7447c2f9fa429926d6a0bfab54ad1f05aebc803c8c367409c1013f9ce37d5332" :commit "78012b0" :description "Symbol reference record: Symbol name + NodeID. Stored in GraphNode.Refs for dependency tracking."))

(define anchor-graph-node (dict :symbol "anchor-graph-node" :name "GraphNode" :file "core/graph.go" :scope "GraphNode" :hash "sha256:4537eb97de456a07b72c8f41073e72cc6fc7bd14c7d6bda7448ac874ff55d3b6" :commit "78012b0" :description "Stored node: resolved AST expression, refs list, and original source string. Immutable once created."))

(define anchor-replay-file (dict :symbol "anchor-replay-file" :name "replayFile" :file "core/graph.go" :scope "Graph.replayFile" :hash "sha256:e6d666a5ee2db8fb9f420289fd0edd90f9eed90252b3229a979a2d39bd2477cc" :commit "78012b0" :description "Replays a log file to reconstruct symbols. Parses entries, calls replayEntryForLib which resolves AST and stores nodes."))

(define anchor-append-log (dict :symbol "anchor-append-log" :name "appendLog" :file "core/graph.go" :scope "Graph.appendLog" :hash "sha256:d0b85058b7db91b97e8212dbf0c9952b6e04262d4fe3f75e9965f3a018540875" :commit "78012b0" :description "Appends a define or delete entry to the active log file."))

(define anchor-library-compact (dict :symbol "anchor-library-compact" :name "LibraryCompact" :file "core/graph.go" :scope "Graph.LibraryCompact" :hash "sha256:668702b9b8e574caf098e97bb97ba9bb45799a9e3e0171831ec0e33908a46004" :commit "78012b0" :description "Rewrites a library file to contain only live symbols in dependency order. Reads current graph state, topological sorts, writes clean file."))

(define arch-graph-libraries-interaction (dict :symbol "arch-graph-libraries-interaction" :name "Graph ↔ Libraries" :description "The graph persists symbols through append-only log files. Define and Delete append entries to the active log. At startup, replayFile reconstructs graph state by re-parsing and re-resolving each entry. LibraryCompact rewrites a library to contain only live symbols in dependency order. The graph tracks symbol ownership to prevent cross-library writes." :keywords (list "replay" "log" "append" "compact" "persist" "library" "symbolOwner" "dependency order") :anchors (list anchor-replay-file anchor-append-log anchor-library-compact) :concepts (list (link 'arch-graph) (link 'arch-libraries))))

(define arch-graph-parser-interaction (dict :symbol "arch-graph-parser-interaction" :name "Graph ↔ Parser" :description "The graph calls Parse to convert source strings to AST in Define, Eval, RefreshAll, and replayFile. The parser produces NodeSymbol nodes which resolveAST then converts to NodeRef (graph symbols) or NodeBuiltin (builtins). This is the bridge between textual source and the resolved dependency graph." :keywords (list "Parse" "NodeSymbol" "NodeRef" "NodeBuiltin" "source" "AST" "text to graph") :anchors (list anchor-resolve-ast anchor-define) :concepts (list (link 'arch-graph) (link 'arch-parser))))

(define arch-graph (dict :symbol "arch-graph" :name "Graph" :description "Dependency-tracked symbol store. Every definition creates an immutable node with a unique versioned ID (node:name-N or node:lib/name-N). Define parses source, resolves all symbols via resolveAST (converting them to NodeRef or NodeBuiltin at define time), stores the resolved AST with its dependency list (Refs), and appends to the log. The evaluator never consults the symbol table — all resolution happens here. RefreshAll propagates changes by BFS through the dependency graph, re-resolving affected symbols and creating new node versions. The Ref and GraphNode types are the core data structures: Ref tracks symbol→nodeID edges, GraphNode stores resolved AST + refs + source." :keywords (list "graph" "symbol" "node" "define" "resolve" "resolveAST" "refresh" "dependency" "immutable" "versioned" "NodeRef" "NodeBuiltin" "Ref" "GraphNode") :anchors (list anchor-graph anchor-define anchor-resolve-ast anchor-refresh-all anchor-make-node-id anchor-ref anchor-graph-node) :interactions (list arch-eval-graph-interaction arch-graph-libraries-interaction arch-graph-parser-interaction) :see-also (list (link 'arch-core-api) (link 'arch-traces) (link 'arch-types) (link 'lang-concept-define-time) (link 'lang-concept-graph))))

(define anchor-parse (dict :symbol "anchor-parse" :name "Parse" :file "core/parser.go" :scope "Parse" :hash "sha256:04b71463a722b8c901bfab5a632e8e242246d628f676802eaae535b64575ee80" :commit "78012b0" :description "Entry point: parses input string to AST Node. Validates no trailing input."))

(define anchor-parser-struct (dict :symbol "anchor-parser-struct" :name "parser" :file "core/parser.go" :scope "parser" :hash "sha256:30d312ef943f1998f0d23efbab16696c09cb7e62fa8894a7c4e7fa3b45b367c4" :commit "78012b0" :description "Local mutable state: input rune slice, current position index."))

(define anchor-parse-node (dict :symbol "anchor-parse-node" :name "parseNode" :file "core/parser.go" :scope "parser.parseNode" :hash "sha256:9a33237170fa5f293c8066d84b21e1d9893e1618382fc3f937b0e23ba0f8cb8b" :commit "78012b0" :description "Dispatcher: routes to quote/list/string/atom based on leading character."))

(define anchor-node (dict :symbol "anchor-node" :name "Node" :file "core/parser.go" :scope "Node" :hash "sha256:4f586fd19ed9f2bb38df064e935f7c1b03fbbba818b745df78c52e4cef34e89b" :commit "78012b0" :description "AST node struct: Kind (NodeKind enum), Int/Float/Bool/Str/Ref storage, Children slice."))

(define anchor-node-kind (dict :symbol "anchor-node-kind" :name "NodeKind" :file "core/parser.go" :scope "NodeKind" :hash "sha256:46fd86b3b8dd70a77c381038963c3145ec993dfbc2976e48369e5c5b303a0e25" :commit "78012b0" :description "AST node type enum: NodeInt, NodeFloat, NodeBool, NodeString, NodeSymbol, NodeList, NodeKeyword, NodeNil, NodeRef, NodeBuiltin."))

(define arch-parser (dict :symbol "arch-parser" :name "Parser" :description "S-expression parser converting text to AST. Parse is the entry point: it creates a parser struct (rune slice + position), dispatches via parseNode to quote/list/string/atom handlers, and produces a tree of Node structs. The parser is simple and stateless — it produces NodeSymbol for identifiers, which are later converted to NodeRef/NodeBuiltin by the graph's resolveAST. Node kinds cover literals (int, float, bool, string, nil, keyword), structure (list), and post-resolution types (ref, builtin)." :keywords (list "parser" "Parse" "AST" "Node" "NodeKind" "S-expression" "parseNode" "atom" "list" "quote" "string" "symbol") :anchors (list anchor-parse anchor-parser-struct anchor-parse-node anchor-node anchor-node-kind) :interactions (list arch-graph-parser-interaction) :see-also (list (link 'arch-evaluator) (link 'arch-types) (link 'lang-syntax))))

(define anchor-value (dict :symbol "anchor-value" :name "Value" :file "core/value.go" :scope "Value" :hash "sha256:55bebbf0131d58dbd4d0d80c0842f7f160f948aac6c392305af84c901b7ca201" :commit "78012b0" :description "Tagged union struct: Kind discriminant + fields Int/Float/Bool/Str/Fn/List/Map/BuiltinName/BuiltinFunc. All 14 types in one struct."))

(define anchor-value-kind (dict :symbol "anchor-value-kind" :name "ValueKind" :file "core/value.go" :scope "ValueKind" :hash "sha256:ee5cd25e6b5c44a40aa30aec47c1342cfb3972c775b967bc614c887214520298" :commit "78012b0" :description "Type enum: ValInt, ValFloat, ValBool, ValString, ValKeyword, ValSymbol, ValNodeRef, ValList, ValMap, ValNil, ValFn, ValForm, ValBuiltin, ValLink."))

(define anchor-fn-value (dict :symbol "anchor-fn-value" :name "FnValue" :file "core/value.go" :scope "FnValue" :hash "sha256:a00e7f9b25b877a6b317ffa7b79167c145f6011cbbacf18c9a4e1924e0c9b879" :commit "78012b0" :description "Function metadata: Params, RestParam, Body (*Node), NodeID, Closure (map[string]Value snapshot)."))

(define anchor-truthy (dict :symbol "anchor-truthy" :name "Truthy" :file "core/value.go" :scope "Value.Truthy" :hash "sha256:edd21c5902281598667c3f8d12f88135142438fecd773610c72d47c901daf42e" :commit "78012b0" :description "Nil and false are falsy, everything else truthy. Implements nil-as-flow semantics."))

(define anchor-values-equal (dict :symbol "anchor-values-equal" :name "ValuesEqual" :file "core/value.go" :scope "ValuesEqual" :hash "sha256:6fc1aef0f0c9f47f9ccfcb42e4b269f4980167c50ebb65135f52a763c84ada8f" :commit "78012b0" :description "Deep equality across all 14 Value kinds. Recursive for lists and maps."))

(define anchor-value-to-go (dict :symbol "anchor-value-to-go" :name "ValueToGo" :file "core/value.go" :scope "ValueToGo" :hash "sha256:7e134e26712c7c6f665b0f48fc58f5a8d85c2ac793090f1080baa535618ce801" :commit "78012b0" :description "Converts logos Value to Go any for JSON serialization. Type-tagged prefixes for node-ref, link, builtin, symbol."))

(define anchor-go-to-value (dict :symbol "anchor-go-to-value" :name "GoToValue" :file "core/value.go" :scope "GoToValue" :hash "sha256:de17570244edf3a3058bebab398ff2d7e1de45a69f2c288fcb240642c39ee6f3" :commit "78012b0" :description "Converts Go any (from JSON) back to logos Value. Reverses ValueToGo prefixes."))

(define arch-types (dict :symbol "arch-types" :name "Types" :description "Runtime value representation: a single tagged-union struct (Value) with a Kind discriminant and type-specific fields. 14 kinds cover primitives (int, float, bool, string, keyword, nil), references (symbol, node-ref, link), collections (list, map), and callables (fn, form, builtin). FnValue holds function metadata including closure (a snapshot of the enclosing scope). Truthy implements nil-as-flow: nil and false are falsy. ValuesEqual provides deep recursive equality. ValueToGo/GoToValue handle JSON serialization with type-tagged prefixes for non-JSON types." :keywords (list "Value" "ValueKind" "type" "tagged union" "FnValue" "closure" "Truthy" "equality" "JSON" "serialization" "ValueToGo" "GoToValue") :anchors (list anchor-value anchor-value-kind anchor-fn-value anchor-truthy anchor-values-equal anchor-value-to-go anchor-go-to-value) :interactions (list arch-eval-types-interaction) :see-also (list (link 'arch-parser) (link 'arch-modules) (link 'lang-types))))

(define anchor-core (dict :symbol "anchor-core" :name "Core" :file "core/core.go" :scope "Core" :hash "sha256:3db14b1f98e08c711a6b89ce22639e00181d87da4da14a72ab0957b2397b0e40" :commit "78012b0" :description "Central actor owning graph state, module registry, sockets, trace buffer."))

(define anchor-handle-request (dict :symbol "anchor-handle-request" :name "handleRequest" :file "core/core.go" :scope "Core.handleRequest" :hash "sha256:44239e5d9605e344d2a441b63a5be4d340cf7d145216dc1281b8632ea15b39a2" :commit "78012b0" :description "Main dispatch switch for all client ops. Routes to op-specific handlers, adds active_library to responses."))

(define anchor-actor-loop (dict :symbol "anchor-actor-loop" :name "actorLoop" :file "core/core.go" :scope "Core.actorLoop" :hash "sha256:0b8444c73ea9553557d6c1e8597db161a350a3a81399a11c21d7f2126c178a44" :commit "78012b0" :description "Single goroutine owning graph state. Reads from requests channel, dispatches callback vs regular requests."))

(define anchor-handle-eval (dict :symbol "anchor-handle-eval" :name "handleEval" :file "core/core.go" :scope "Core.handleEval" :hash "sha256:2eed5160b7c1cfdcbb39d71176c7f1b5b6e322c89e2a25263f7e396e741d6c1d" :commit "78012b0" :description "Parses expr, resolves AST, evaluates via graph.Eval, records trace, serializes result."))

(define anchor-write-msg (dict :symbol "anchor-write-msg" :name "WriteMsg" :file "core/protocol.go" :scope "WriteMsg" :hash "sha256:75507d608b4ddab4eaf0d629640afcf5165229116006b02642ff2a97205579f2" :commit "78012b0" :description "Sends a length-prefixed JSON message: 4-byte big-endian length + JSON body."))

(define anchor-read-msg (dict :symbol "anchor-read-msg" :name "ReadMsg" :file "core/protocol.go" :scope "ReadMsg" :hash "sha256:05211fde0fc8e8854b8701500176783c0778b35d5efbd09ee201405a8f1abf40" :commit "78012b0" :description "Reads a length-prefixed JSON message from a connection."))

(define arch-core-api (dict :symbol "arch-core-api" :name "Core API" :description "Request/response dispatcher at the heart of the system. The Core struct owns the graph, module registry, and trace buffer. All graph mutations are serialized through a single actor goroutine (actorLoop) that reads from a requests channel. handleRequest is the main dispatch switch routing ops (eval, define, delete, refresh-all, library ops, fuel, clear) to specific handlers. The wire protocol (WriteMsg/ReadMsg) uses 4-byte big-endian length prefix + JSON body over unix domain sockets. Three socket types: CLI (client requests), module (outbound to modules), and callback (inbound from modules)." :keywords (list "Core" "API" "dispatch" "handleRequest" "actorLoop" "actor" "socket" "request" "response" "wire protocol" "WriteMsg" "ReadMsg" "JSON") :anchors (list anchor-core anchor-handle-request anchor-actor-loop anchor-handle-eval anchor-write-msg anchor-read-msg) :interactions (list) :see-also (list (link 'arch-evaluator) (link 'arch-graph) (link 'arch-modules) (link 'arch-libraries) (link 'arch-traces) (link 'arch-mcp))))

(define anchor-module-info (dict :symbol "anchor-module-info" :name "ModuleInfo" :file "core/core.go" :scope "ModuleInfo" :hash "sha256:147fe56cb2bf84862e028b9d8ec52ee613712306f35b5ea9724b11984ed4b48a" :commit "78012b0" :description "Tracks a connected module: ID (name), Manual (discovery response), conn (socket), mu (serializes reads/writes)."))

(define anchor-handle-module-connection (dict :symbol "anchor-handle-module-connection" :name "handleModuleConnection" :file "core/core.go" :scope "Core.handleModuleConnection" :hash "sha256:cfb6eff71b44afb9843b1a50d90ecf499eb6d5a398f8fa8905e1c7352c9d8496" :commit "78012b0" :description "Receives module connection: sends discovery request, receives name + manual, registers in modules map."))

