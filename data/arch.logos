(define anchor-read-manifest (dict :symbol "anchor-read-manifest" :name "readManifest" :file "core/graph.go" :scope "readManifest" :hash "sha256:8532ebbbf65ebfaeb3f63b6ccf16bc58270620580548dfcb03657946b7cb9eb0" :commit "78012b0" :description "Reads library-order.txt: one library name per line. Returns ordered list."))

(define arch-libraries (dict :symbol "arch-libraries" :name "Libraries" :description "Persistent symbol storage via append-only log files. Each library is a file of (define name expr) and (delete name) entries. At startup, loadLibraries reads the manifest (library-order.txt) and replays each library in order. LibraryCreate/Open/Close manage the lifecycle: opening a library switches the active write target so defines go to the library file instead of the session log. LibraryCompact rewrites a library to contain only live symbols in dependency order. Symbol ownership (symbolOwner map) prevents cross-library writes. The session log captures ephemeral definitions not assigned to any library." :keywords (list "library" "persist" "log" "replay" "manifest" "compact" "create" "open" "close" "symbolOwner" "append-only" "dependency order") :anchors (list anchor-load-libraries anchor-library-create anchor-library-open anchor-library-close anchor-read-manifest anchor-replay-file anchor-append-log anchor-library-compact) :interactions (list arch-graph-libraries-interaction) :see-also (list (link 'arch-core-api) (link 'arch-graph) (link 'arch-parser))))

