(define anchor-mcp-format-result (dict :symbol "anchor-mcp-format-result" :name "formatResult" :file "mcp-logos/main.go" :scope "formatResult" :hash "sha256:0d712739d7f8368b3549a2b0451ad2c23f89c24421b65ca04d9c2cd0da8001a7" :commit "78012b0" :description "Converts logos core response to MCP tool result: wraps value + active_library in JSON."))

(define arch-mcp (dict :symbol "arch-mcp" :name "MCP Server" :description "Lightweight proxy exposing logos operations as MCP tools for Claude Code. A separate binary (mcp-logos) that connects to core via the CLI socket. 16 tools map 1:1 to core ops: eval, define, delete, refresh-all, 8 library lifecycle ops, clear, set-fuel, get-fuel, and manual. Each handler extracts parameters, builds a request dict with an op field, sends via the CLI socket using the same wire protocol (4-byte length prefix + JSON), and formats the response as an MCP CallToolResult." :keywords (list "MCP" "Claude Code" "tool" "proxy" "CLI socket" "mcp-logos" "eval" "define" "library") :anchors (list anchor-mcp-send anchor-mcp-format-result) :interactions (list) :see-also (list (link 'arch-core-api) (link 'arch-libraries))))

(define arch (dict :symbol "arch" :name "Logos Architecture Reference" :description "Architecture documentation for the logos v3 runtime. Each concept node describes a subsystem with code anchors validated against the source via mod-go. Interaction nodes document how subsystems connect, with their own anchors at boundary points. Cross-references to the lang library link implementation to language semantics." :members (list arch-evaluator arch-graph arch-parser arch-types arch-core-api arch-modules arch-libraries arch-step-debugger arch-traces arch-mcp)))

(define arch-collect-anchors (fn (root)
  (let (members (get root :members))
    (loop ((stack members) (all-anchors (list)) (seen-ints (list)))
      (if (empty? stack)
        all-anchors
        (let (cur (head stack)
              concept-anchors (if (nil? (get cur :anchors)) (list) (get cur :anchors))
              interactions (if (nil? (get cur :interactions)) (list) (get cur :interactions))
              int-result (loop ((ints interactions) (iacc (list)) (seen seen-ints))
                           (if (empty? ints)
                             (dict :anchors iacc :seen seen)
                             (let (int-node (head ints)
                                   int-sym (get int-node :symbol))
                               (if (member? seen int-sym)
                                 (recur (rest ints) iacc seen)
                                 (recur (rest ints)
                                        (append iacc (if (nil? (get int-node :anchors)) (list) (get int-node :anchors)))
                                        (cons int-sym seen)))))))
          (recur (rest stack)
                 (append (append all-anchors concept-anchors) (get int-result :anchors))
                 (get int-result :seen))))))))

(define arch-validate (fn (root)
  (let (raw-anchors (arch-collect-anchors root)
        anchors (loop ((as raw-anchors) (acc (list)) (seen (list)))
                  (if (empty? as)
                    (reverse acc)
                    (let (a (head as)
                          sym (get a :symbol))
                      (if (member? seen sym)
                        (recur (rest as) acc seen)
                        (recur (rest as) (cons a acc) (cons sym seen))))))
        anchor-data (map (fn (a) (dict "file" (get a :file) "scope" (get a :scope) "expected_hash" (get a :hash))) anchors)
        results (send "mod-go" (dict "op" "validate-anchors" "anchors" anchor-data))
        paired (loop ((as anchors) (rs results) (acc (list)))
                 (if (empty? as)
                   (reverse acc)
                   (let (a (head as)
                         r (head rs)
                         status (get r "status"))
                     (recur (rest as) (rest rs)
                            (cons (dict :symbol (get a :symbol) :file (get a :file) :scope (get a :scope) :status status :current-hash (if (eq status "changed") (get r "current_hash") nil)) acc)))))
        valid (filter (fn (p) (eq (get p :status) "valid")) paired)
        changed (filter (fn (p) (eq (get p :status) "changed")) paired)
        not-found (filter (fn (p) (eq (get p :status) "not_found")) paired))
    (dict :total (len paired) :valid (len valid) :changed (len changed) :not-found (len not-found) :details (append changed not-found)))))

(define arch-describe (fn (node & opts)
  (let (depth (if (empty? opts) :brief (head opts)))
    (loop ((stack (list (list node 0))) (acc ""))
      (if (empty? stack)
        acc
        (let (entry (head stack)
              rest-stack (rest stack)
              cur (head entry)
              level (nth entry 1)
              name (get cur :name)
              desc (get cur :description)
              members (get cur :members)
              anchors (get cur :anchors)
              interactions (get cur :interactions)
              see-also (get cur :see-also)
              keywords (get cur :keywords)
              is-root (not (nil? members))
              detail (or (eq depth :full) (gt level 0))
              prefix (if (eq level 0) "## " (if (eq level 1) "### " "#### "))
              sub-prefix (if (eq level 0) "### " (if (eq level 1) "#### " "##### "))
              header (concat prefix name "\n\n" desc "\n")
              kw-sec (if (nil? keywords) ""
                (concat "\n**Keywords**: " (join ", " keywords) "\n"))
              anchor-sec (if (or (nil? anchors) (empty? anchors)) ""
                (if detail
                  (concat "\n" sub-prefix "Anchors\n"
                    (join "\n" (map (fn (a)
                      (concat "- **" (get a :name) "** (" (get a :file) ": " (get a :scope) "): " (get a :description)))
                      anchors))
                    "\n")
                  (concat "\n**Anchors**: " (join ", " (map (fn (a) (get a :name)) anchors)) "\n")))
              int-sec (if (or (nil? interactions) (empty? interactions)) ""
                (if detail
                  (concat "\n" sub-prefix "Interactions\n"
                    (join "\n" (map (fn (i)
                      (concat "- **" (get i :name) "**: " (get i :description)))
                      interactions))
                    "\n")
                  (concat "\n**Interactions**: " (join ", " (map (fn (i) (get i :name)) interactions)) "\n")))
              sa-sec (if (or (nil? see-also) (empty? see-also)) ""
                (if detail
                  (concat "\n**See Also**: "
                    (join ", " (map (fn (l) (to-string (link-target l))) see-also))
                    "\n")
                  ""))
              member-sec (if (or (nil? members) (empty? members)) ""
                (if (not detail)
                  (concat "\n" sub-prefix "Members\n"
                    (join "\n" (map (fn (m) (concat "- **" (get m :name) "**: " (get m :description))) members))
                    "\n")
                  ""))
              new-stack (if (and is-root detail)
                (append (map (fn (m) (list m (add level 1))) members) rest-stack)
                rest-stack))
          (recur new-stack
                 (concat acc header kw-sec
                   member-sec anchor-sec int-sec sa-sec "\n"))))))))

(define arch-search (fn (query & opts)
  (let (depth (if (empty? opts) 1 (head opts))
        raw (loop ((stack (list (list arch "" "")))
                   (acc (list)))
              (if (empty? stack)
                acc
                (let (entry (head stack)
                      rest-stack (rest stack)
                      cur (head entry)
                      path (nth entry 1)
                      parent-name (nth entry 2)
                      name (get cur :name)
                      current-path (if (eq path "") name (concat path " > " name))
                      is-match (lang-search-matches? cur query)
                      file (get cur :file)
                      is-anchor (not (nil? file))
                      own-result (if is-match
                        (list (let (base (dict :name name :symbol (get cur :symbol) :path current-path)
                                    r1 (if (ge depth 1) (put base :description (get cur :description)) base)
                                    r2 (if (and (ge depth 2) is-anchor) (put (put r1 :file file) :scope (get cur :scope)) r1)
                                    r3 (if (and (ge depth 2) (not is-anchor)) (if (not (nil? (get cur :keywords))) (put r2 :keywords (get cur :keywords)) r2) r2))
                               r3))
                        (list))
                      anchors (if (nil? (get cur :anchors)) (list) (get cur :anchors))
                      interactions (if (nil? (get cur :interactions)) (list) (get cur :interactions))
                      members (if (nil? (get cur :members)) (list) (get cur :members))
                      children (fold (fn (a b) (append a b)) (list)
                        (list members interactions anchors))
                      child-entries (map (fn (c) (list c current-path name)) children))
                  (recur (append child-entries rest-stack)
                         (append acc own-result))))))
    (loop ((items raw) (seen (list)) (acc (list)))
      (if (empty? items)
        (reverse acc)
        (let (item (head items)
              sym (get item :symbol))
          (if (member? seen sym)
            (recur (rest items) seen acc)
            (recur (rest items) (cons sym seen) (cons item acc)))))))))

(define anchor-handle-request (dict :symbol "anchor-handle-request" :name "handleRequest" :file "core/core.go" :scope "Core.handleRequest" :hash "sha256:b765e9b7ad021c190e83acd6af0d4d9e7d5d83f5ec902786639fb33901d76efe" :commit "ab1fb73" :description "Main dispatch switch for all client ops. Routes to op-specific handlers, adds active_library to responses."))

(define arch (dict :symbol "arch" :name "Logos Architecture Reference" :description "Architecture documentation for the logos v3 runtime. Each concept node describes a subsystem with code anchors validated against the source via mod-go. Interaction nodes document how subsystems connect, with their own anchors at boundary points. Cross-references to the lang library link implementation to language semantics." :members (list arch-evaluator arch-graph arch-parser arch-types arch-core-api arch-modules arch-libraries arch-step-debugger arch-traces arch-mcp)))

(define arch-core-api (dict :symbol "arch-core-api" :name "Core API" :description "Request/response dispatcher at the heart of the system. The Core struct owns the graph, module registry, and trace buffer. All graph mutations are serialized through a single actor goroutine (actorLoop) that reads from a requests channel. handleRequest is the main dispatch switch routing ops (eval, define, delete, refresh-all, library ops, fuel, clear) to specific handlers. The wire protocol (WriteMsg/ReadMsg) uses 4-byte big-endian length prefix + JSON body over unix domain sockets. Three socket types: CLI (client requests), module (outbound to modules), and callback (inbound from modules)." :keywords (list "Core" "API" "dispatch" "handleRequest" "actorLoop" "actor" "socket" "request" "response" "wire protocol" "WriteMsg" "ReadMsg" "JSON") :anchors (list anchor-core anchor-handle-request anchor-actor-loop anchor-handle-eval anchor-write-msg anchor-read-msg) :interactions (list) :see-also (list (link 'arch-evaluator) (link 'arch-graph) (link 'arch-modules) (link 'arch-libraries) (link 'arch-traces) (link 'arch-mcp))))

(define arch-search (fn (query & opts)
  (let (depth (if (empty? opts) 1 (head opts))
        raw (loop ((stack (list (list arch "" "")))
                   (acc (list)))
              (if (empty? stack)
                acc
                (let (entry (head stack)
                      rest-stack (rest stack)
                      cur (head entry)
                      path (nth entry 1)
                      parent-name (nth entry 2)
                      name (get cur :name)
                      current-path (if (eq path "") name (concat path " > " name))
                      is-match (lang-search-matches? cur query)
                      file (get cur :file)
                      is-anchor (not (nil? file))
                      own-result (if is-match
                        (list (let (base (dict :name name :symbol (get cur :symbol) :path current-path)
                                    r1 (if (ge depth 1) (put base :description (get cur :description)) base)
                                    r2 (if (and (ge depth 2) is-anchor) (put (put r1 :file file) :scope (get cur :scope)) r1)
                                    r3 (if (and (ge depth 2) (not is-anchor)) (if (not (nil? (get cur :keywords))) (put r2 :keywords (get cur :keywords)) r2) r2))
                               r3))
                        (list))
                      anchors (if (nil? (get cur :anchors)) (list) (get cur :anchors))
                      interactions (if (nil? (get cur :interactions)) (list) (get cur :interactions))
                      members (if (nil? (get cur :members)) (list) (get cur :members))
                      children (fold (fn (a b) (append a b)) (list)
                        (list members interactions anchors))
                      child-entries (map (fn (c) (list c current-path name)) children))
                  (recur (append child-entries rest-stack)
                         (append acc own-result))))))
    (loop ((items raw) (seen (list)) (acc (list)))
      (if (empty? items)
        (reverse acc)
        (let (item (head items)
              sym (get item :symbol))
          (if (member? seen sym)
            (recur (rest items) seen acc)
            (recur (rest items) (cons sym seen) (cons item acc)))))))))

