(define arch-collect-anchors (fn (root)
  (let (members (get root :members))
    (loop ((stack members) (all-anchors (list)) (seen-ints (list)))
      (if (empty? stack)
        all-anchors
        (let (cur (head stack)
              concept-anchors (if (nil? (get cur :anchors)) (list) (get cur :anchors))
              sub-concepts (if (nil? (get cur :sub-concepts)) (list) (get cur :sub-concepts))
              sub-anchors (loop ((subs sub-concepts) (sacc (list)))
                            (if (empty? subs)
                              sacc
                              (recur (rest subs)
                                     (append sacc (if (nil? (get (head subs) :anchors)) (list) (get (head subs) :anchors))))))
              interactions (if (nil? (get cur :interactions)) (list) (get cur :interactions))
              int-result (loop ((ints interactions) (iacc (list)) (seen seen-ints))
                           (if (empty? ints)
                             (dict :anchors iacc :seen seen)
                             (let (int-node (head ints)
                                   int-sym (get int-node :symbol))
                               (if (member? seen int-sym)
                                 (recur (rest ints) iacc seen)
                                 (recur (rest ints)
                                        (append iacc (if (nil? (get int-node :anchors)) (list) (get int-node :anchors)))
                                        (cons int-sym seen)))))))
          (recur (rest stack)
                 (append (append (append all-anchors concept-anchors) sub-anchors) (get int-result :anchors))
                 (get int-result :seen))))))))

(test arch-collect-anchors "handles-empty-root" (eq (list) (arch-collect-anchors (dict :members (list)))))

(define arch-core-api-contract-handlers (dict :symbol "arch-core-api-contract-handlers" :name "Contract Handlers" :description "Core API handlers for contract and define operations with auto-cascade. handleDefine calls Graph.DefineWithTests and automatically triggers RefreshAll on redefine. handleRefine calls Graph.Refine and automatically triggers RefreshAll when propagation is indicated. Both return cascade results (refreshed, red, stale) inline. handleSymbolStatus queries a single symbol's green/red/untested status. handleRedSymbols and handleGreenSymbols return sorted lists. handleRefreshAll extracts targets and dry flag, delegates to Graph.RefreshAll." :keywords (list "handleDefine" "handleRefine" "handleSymbolStatus" "handleRedSymbols" "handleGreenSymbols" "handleRefreshAll" "contract" "API" "handler" "auto-cascade") :anchors (list anchor-handle-define anchor-handle-refine anchor-handle-symbol-status anchor-handle-red-symbols anchor-handle-green-symbols anchor-handle-refresh-all) :see-also (list (link 'arch-core-api) (link 'arch-graph-refine) (link 'arch-graph-symbol-status) (link 'arch-graph-cascade))))

(test arch-core-api-contract-handlers "has-concept-shape" (let (c arch-core-api-contract-handlers) (and (not (nil? (get c :symbol))) (not (nil? (get c :name))) (not (nil? (get c :description))) (not (nil? (get c :keywords))) (not (nil? (get c :anchors))) (not (empty? (get c :anchors))))))

(define arch-core-api (dict :symbol "arch-core-api" :name "Core API" :description "Request/response dispatcher at the heart of the system. The Core struct owns the graph, module registry, and trace buffer. All graph mutations are serialized through a single actor goroutine (actorLoop) that reads from a requests channel. handleRequest is the main dispatch switch routing ops (eval, define, refine, delete, refresh-all, symbol-status, red-symbols, green-symbols, library ops, fuel, clear, source, promote) to specific handlers. The wire protocol (WriteMsg/ReadMsg) uses 4-byte big-endian length prefix + JSON body over unix domain sockets. Three socket types: CLI (client requests), module (outbound to modules), and callback (inbound from modules)." :keywords (list "Core" "API" "dispatch" "handleRequest" "actorLoop" "actor" "socket" "request" "response" "wire protocol" "WriteMsg" "ReadMsg" "JSON" "refine" "symbol-status" "red-symbols" "green-symbols") :anchors (list anchor-core anchor-handle-request anchor-actor-loop anchor-handle-eval anchor-write-msg anchor-read-msg) :sub-concepts (list arch-core-api-contract-handlers) :interactions (list) :see-also (list (link 'arch-evaluator) (link 'arch-graph) (link 'arch-modules) (link 'arch-libraries) (link 'arch-traces) (link 'arch-mcp))))

(test arch-core-api "has-concept-shape" (let (c arch-core-api) (and (not (nil? (get c :symbol))) (not (nil? (get c :name))) (not (nil? (get c :description))) (not (nil? (get c :keywords))) (not (nil? (get c :anchors))) (not (empty? (get c :anchors))))))

(define arch-eval-graph-interaction (dict :symbol "arch-eval-graph-interaction" :name "Evaluator ↔ Graph" :description "The evaluator resolves node references via ResolveNode on every NodeRef encountered in evalStep. At define time, the graph's resolveAST transforms symbols into NodeRef/NodeBuiltin before the evaluator sees them. The evaluator tracks currentNodeID for error attribution and trace context." :keywords (list "resolve" "node-ref" "ResolveNode" "ResolveAST" "currentNodeID" "symbol resolution" "define time") :anchors (list anchor-resolve-symbol) :concepts (list (link 'arch-evaluator) (link 'arch-graph))))

(test arch-eval-graph-interaction "has-interaction-shape" (let (i arch-eval-graph-interaction) (and (not (nil? (get i :symbol))) (not (nil? (get i :name))) (not (nil? (get i :description))) (not (nil? (get i :keywords))) (not (nil? (get i :anchors))) (not (nil? (get i :concepts))))))

(define arch-eval-step-debugger-interaction (dict :symbol "arch-eval-step-debugger-interaction" :name "Evaluator ↔ Step Debugger" :description "The step debugger wraps evalStep to allow single-stepping through evaluation. evalState is serialized to/from logos Values via evalStateToValue and valueToEvalState, enabling suspended evaluation that persists across calls. Each frame kind has its own serialization logic." :keywords (list "step" "debugger" "serialize" "suspend" "resume" "evalState" "frame serialization" "step-eval" "step-continue") :anchors (list anchor-eval-state-to-value anchor-value-to-eval-state) :concepts (list (link 'arch-evaluator) (link 'arch-step-debugger))))

(test arch-eval-step-debugger-interaction "has-interaction-shape" (let (i arch-eval-step-debugger-interaction) (and (not (nil? (get i :symbol))) (not (nil? (get i :name))) (not (nil? (get i :description))) (not (nil? (get i :keywords))) (not (nil? (get i :anchors))) (not (nil? (get i :concepts))))))

(define arch-eval-types-interaction (dict :symbol "arch-eval-types-interaction" :name "Evaluator ↔ Types" :description "The evaluator is the primary producer and consumer of Values. evalStep dispatches on node kind to produce typed Values (IntVal, BoolVal, etc.), uses Value.Truthy() for conditionals, and captures scope as map[string]Value for closures. nodeToValue/valueToNode provide round-trip AST conversion for quote and form expansion." :keywords (list "Value" "type dispatch" "Truthy" "closure" "scope" "nodeToValue" "valueToNode" "AST conversion" "quote" "form expansion") :anchors (list anchor-node-to-value anchor-value-to-node anchor-data-builtins) :concepts (list (link 'arch-evaluator) (link 'arch-types))))

(test arch-eval-types-interaction "has-interaction-shape" (let (i arch-eval-types-interaction) (and (not (nil? (get i :symbol))) (not (nil? (get i :name))) (not (nil? (get i :description))) (not (nil? (get i :keywords))) (not (nil? (get i :anchors))) (not (nil? (get i :concepts))))))

(define arch-evaluator (dict :symbol "arch-evaluator" :name "Evaluator" :description "Frame-based iterative evaluator with no Go recursion. The core state machine (evalStep) processes one iteration per call: dispatches on AST node kind during the evaluation phase, then pops and processes stack frames during the value phase. 14 frame kinds encode all evaluation contexts — function calls, conditionals, let bindings, loop/recur, form expansion, apply, and sequential execution. The frame stack replaces the Go call stack, eliminating stack overflow risk and enabling the step debugger to suspend and resume evaluation. Re-entrant via CallFnWithValues for form expansion and sort-by." :keywords (list "evaluator" "eval" "frame" "stack" "iterative" "state machine" "evalStep" "evalLoop" "fuel" "re-entrant") :anchors (list anchor-evaluator anchor-eval-step anchor-eval-loop anchor-eval-loop-with anchor-frame anchor-eval-state anchor-enter-fn-body anchor-handle-form-call anchor-call-fn-with-values) :interactions (list arch-eval-graph-interaction arch-eval-step-debugger-interaction arch-eval-types-interaction) :see-also (list (link 'arch-parser) (link 'arch-libraries) (link 'arch-traces) (link 'lang-form-loop) (link 'lang-form-fn) (link 'lang-form-form) (link 'lang-form-if) (link 'lang-form-let) (link 'lang-concept-closures) (link 'lang-concept-iteration) (link 'lang-concept-define-time))))

(test arch-evaluator "has-concept-shape" (let (c arch-evaluator) (and (not (nil? (get c :symbol))) (not (nil? (get c :name))) (not (nil? (get c :description))) (not (nil? (get c :keywords))) (not (nil? (get c :anchors))) (not (empty? (get c :anchors))))))

(define arch-graph-cascade (dict :symbol "arch-graph-cascade" :name "Cascade" :description "When a symbol changes, RefreshAll dispatches to refreshAllLive for the live cascade. BFS through dependents with circuit breaker: contracted symbols (have tests) are re-resolved and their tests run — pass → new Green node + continue propagation, fail → Red + stop branch. Untested symbols become stale + stop (no auto-refresh without contract). RefreshResult collects three lists: Refreshed, Red, Stale. Red is the circuit breaker — it prevents cascading failures and marks the LLM's reconciliation work list." :keywords (list "cascade" "circuit breaker" "RefreshAll" "refreshAllLive" "BFS" "propagation" "auto-refresh" "Green" "Red" "stale" "RefreshResult") :anchors (list anchor-refresh-all anchor-refresh-all-live anchor-refresh-result) :see-also (list (link 'arch-graph) (link 'arch-graph-symbol-status) (link 'arch-graph-refine))))

(test arch-graph-cascade "has-concept-shape" (let (c arch-graph-cascade) (and (not (nil? (get c :symbol))) (not (nil? (get c :name))) (not (nil? (get c :description))) (not (nil? (get c :keywords))) (not (nil? (get c :anchors))) (not (empty? (get c :anchors))))))

(define arch-graph-libraries-interaction (dict :symbol "arch-graph-libraries-interaction" :name "Graph ↔ Libraries" :description "The graph persists symbols through append-only log files. Define and Delete append entries to the active log. DefineWithTests also writes (test name label expr) entries for contracted symbols. At startup, replayFile reconstructs graph state by re-parsing and re-resolving each entry including tests. LibraryCompact rewrites a library to contain only live symbols in dependency order with their test entries. The graph tracks symbol ownership to prevent cross-library writes." :keywords (list "replay" "log" "append" "compact" "persist" "library" "symbolOwner" "dependency order" "test entry") :anchors (list anchor-replay-file anchor-append-log anchor-library-compact) :concepts (list (link 'arch-graph) (link 'arch-libraries))))

(test arch-graph-libraries-interaction "has-interaction-shape" (let (i arch-graph-libraries-interaction) (and (not (nil? (get i :symbol))) (not (nil? (get i :name))) (not (nil? (get i :description))) (not (nil? (get i :keywords))) (not (nil? (get i :anchors))) (not (nil? (get i :concepts))))))

(define arch-graph-parser-interaction (dict :symbol "arch-graph-parser-interaction" :name "Graph ↔ Parser" :description "The graph calls Parse to convert source strings to AST in DefineWithTests, Refine, Eval, RefreshAll, and replayFile. The parser produces NodeSymbol nodes which resolveAST then converts to NodeRef (graph symbols) or NodeBuiltin (builtins). For test expressions, resolveTestAST applies restricted resolution (builtins + base + shapes + self) and tracks refs for cascade propagation. This is the bridge between textual source and the resolved dependency graph." :keywords (list "Parse" "NodeSymbol" "NodeRef" "NodeBuiltin" "source" "AST" "text to graph" "resolveTestAST" "shapes") :anchors (list anchor-resolve-ast anchor-define anchor-resolve-test-ast) :concepts (list (link 'arch-graph) (link 'arch-parser))))

(test arch-graph-parser-interaction "has-interaction-shape" (let (i arch-graph-parser-interaction) (and (not (nil? (get i :symbol))) (not (nil? (get i :name))) (not (nil? (get i :description))) (not (nil? (get i :keywords))) (not (nil? (get i :anchors))) (not (nil? (get i :concepts))))))

(define arch-graph-refine (dict :symbol "arch-graph-refine" :name "Refine" :description "Creates a new node for an existing symbol by applying deltas. Carries forward unchanged fields from the current node (expression, tests). Supports: new expr, add test, remove test, or combinations. Runs the test gate on the resulting node. Returns a propagation flag: suppressed when both expr and tests change simultaneously (the LLM changed the rules and the code at once). Otherwise, triggers cascade via RefreshAll." :keywords (list "refine" "delta" "carry forward" "immutable update" "propagation" "suppress") :anchors (list anchor-refine) :see-also (list (link 'arch-graph) (link 'arch-graph-test-gate) (link 'arch-graph-cascade))))

(test arch-graph-refine "has-concept-shape" (let (c arch-graph-refine) (and (not (nil? (get c :symbol))) (not (nil? (get c :name))) (not (nil? (get c :description))) (not (nil? (get c :keywords))) (not (nil? (get c :anchors))) (not (empty? (get c :anchors))))))

(define arch-graph-symbol-status (dict :symbol "arch-graph-symbol-status" :name "Symbol Status" :description "Symbols gain a status tracked in the symbolStatus map: untested (no contract, no auto-refresh), green (has contract, all deps current, tests pass), or red (has contract, stale deps, pinned to older version). SymbolStatus is a Go int enum. GetSymbolStatus queries a single symbol. RedSymbols and GreenSymbols return sorted lists for the LLM's work list and health overview. Status is updated during DefineWithTests, Refine, and refreshAllLive." :keywords (list "status" "green" "red" "untested" "SymbolStatus" "GetSymbolStatus" "RedSymbols" "GreenSymbols" "symbolStatus map" "work list") :anchors (list anchor-symbol-status-type anchor-get-symbol-status anchor-red-symbols anchor-green-symbols) :see-also (list (link 'arch-graph) (link 'arch-graph-cascade) (link 'arch-graph-test-gate))))

(test arch-graph-symbol-status "has-concept-shape" (let (c arch-graph-symbol-status) (and (not (nil? (get c :symbol))) (not (nil? (get c :name))) (not (nil? (get c :description))) (not (nil? (get c :keywords))) (not (nil? (get c :anchors))) (not (empty? (get c :anchors))))))

(define arch-graph-test-gate (dict :symbol "arch-graph-test-gate" :name "Test Gate" :description "Nodes gain an optional Tests field ([]GraphNodeTest). When tests are provided to DefineWithTests, each test expression is parsed and resolved via resolveTestAST (restricted to builtins + base + shapes + self), then evaluated. All must return truthy or the define fails — no node created, no log entry written. This guarantees: a node always satisfies its own contract at creation time. Test expression refs are merged into the node's Refs, enabling refresh-all cascade through test dependencies. TestInput is the wire format; GraphNodeTest is the stored format with resolved AST." :keywords (list "test" "gate" "contract" "DefineWithTests" "resolveTestAST" "GraphNodeTest" "TestInput" "restricted scope" "builtins" "base" "shapes" "test refs") :anchors (list anchor-define-with-tests anchor-resolve-test-ast anchor-graph-node-test anchor-test-input) :see-also (list (link 'arch-graph) (link 'arch-graph-refine) (link 'arch-graph-parser-interaction))))

(test arch-graph-test-gate "has-concept-shape" (let (c arch-graph-test-gate) (and (not (nil? (get c :symbol))) (not (nil? (get c :name))) (not (nil? (get c :description))) (not (nil? (get c :keywords))) (not (nil? (get c :anchors))) (not (empty? (get c :anchors))))))

(define arch-graph (dict :symbol "arch-graph" :name "Graph" :description "Dependency-tracked symbol store with contract support. Every definition creates an immutable node with a unique versioned ID (node:name-N or node:lib/name-N). DefineWithTests parses source, resolves all symbols via resolveAST (converting them to NodeRef or NodeBuiltin at define time), optionally resolves test ASTs via resolveTestAST (restricted scope: builtins + base + shapes + self), runs the test gate, stores the resolved AST with its dependency list (Refs) and Tests, and appends to the log. Test expression refs are merged into Refs for cascade propagation. Refine evolves an existing symbol with deltas (new expr, add/remove tests), carrying forward unchanged fields. The evaluator never consults the symbol table — all resolution happens here. RefreshAll propagates changes via BFS with circuit breaker: contracted symbols auto-refresh (Green) or mark Red; untested symbols stop propagation. Symbol status (green/red/untested) is tracked in symbolStatus map." :keywords (list "graph" "symbol" "node" "define" "resolve" "resolveAST" "refresh" "dependency" "immutable" "versioned" "NodeRef" "NodeBuiltin" "Ref" "GraphNode" "contract" "test" "refine" "green" "red" "circuit breaker" "resolveTestAST" "shapes" "test refs") :anchors (list anchor-graph anchor-define anchor-resolve-ast anchor-refresh-all anchor-make-node-id anchor-ref anchor-graph-node) :sub-concepts (list arch-graph-test-gate arch-graph-refine arch-graph-symbol-status arch-graph-cascade) :interactions (list arch-eval-graph-interaction arch-graph-libraries-interaction arch-graph-parser-interaction) :see-also (list (link 'arch-core-api) (link 'arch-traces) (link 'arch-types) (link 'lang-concept-define-time) (link 'lang-concept-graph))))

(test arch-graph "has-concept-shape" (let (c arch-graph) (and (not (nil? (get c :symbol))) (not (nil? (get c :name))) (not (nil? (get c :description))) (not (nil? (get c :keywords))) (not (nil? (get c :anchors))) (not (empty? (get c :anchors))))))

(define arch-libraries-special (dict :symbol "arch-libraries-special" :name "Special Libraries" :description "Base and shapes are protected libraries with special status in the runtime. Base is always first in load order, shapes always second. Neither can be deleted via LibraryDelete. LibraryOrderSet enforces their positions. Both are accessible in test expressions via resolveTestAST — base provides core utilities, shapes provides data validation predicates. Shapes is auto-created by loadLibraries on first startup if missing." :keywords (list "base" "shapes" "protected" "special" "test scope" "resolveTestAST" "auto-create" "load order") :anchors (list anchor-load-libraries anchor-resolve-test-ast) :see-also (list (link 'arch-graph-test-gate))))

(define arch-libraries (dict :symbol "arch-libraries" :name "Libraries" :description "Persistent symbol storage via append-only log files. Each library is a file of (define name expr), (test name label expr), and (delete name) entries. At startup, loadLibraries reads the manifest (library-order.txt) and replays each library in order. LibraryCreate/Open/Close manage the lifecycle: opening a library switches the active write target so defines go to the library file instead of the session log. LibraryCompact rewrites a library to contain only live symbols in dependency order, including test entries. Symbol ownership (symbolOwner map) prevents cross-library writes. Base and shapes are protected libraries with special status. The session log captures ephemeral definitions not assigned to any library." :keywords (list "library" "persist" "log" "replay" "manifest" "compact" "create" "open" "close" "symbolOwner" "append-only" "dependency order" "test entry" "base" "shapes" "protected") :anchors (list anchor-load-libraries anchor-library-create anchor-library-open anchor-library-close anchor-read-manifest anchor-replay-file anchor-append-log anchor-library-compact) :sub-concepts (list arch-libraries-special) :interactions (list arch-graph-libraries-interaction) :see-also (list (link 'arch-core-api) (link 'arch-graph) (link 'arch-parser))))

(test arch-libraries "has-concept-shape" (let (c arch-libraries) (and (not (nil? (get c :symbol))) (not (nil? (get c :name))) (not (nil? (get c :description))) (not (nil? (get c :keywords))) (not (nil? (get c :anchors))) (not (empty? (get c :anchors))))))

(define arch-mcp (dict :symbol "arch-mcp" :name "MCP Server" :description "Lightweight proxy exposing logos operations as MCP tools for Claude Code. A separate binary (mcp-logos) that connects to core via the CLI socket. 16 tools map 1:1 to core ops: eval, define, delete, refresh-all, 8 library lifecycle ops, clear, set-fuel, get-fuel, and manual. Each handler extracts parameters, builds a request dict with an op field, sends via the CLI socket using the same wire protocol (4-byte length prefix + JSON), and formats the response as an MCP CallToolResult." :keywords (list "MCP" "Claude Code" "tool" "proxy" "CLI socket" "mcp-logos" "eval" "define" "library") :anchors (list anchor-mcp-send anchor-mcp-format-result) :interactions (list) :see-also (list (link 'arch-core-api) (link 'arch-libraries))))

(test arch-mcp "has-concept-shape" (let (c arch-mcp) (and (not (nil? (get c :symbol))) (not (nil? (get c :name))) (not (nil? (get c :description))) (not (nil? (get c :keywords))) (not (nil? (get c :anchors))) (not (empty? (get c :anchors))))))

(define arch-modules (dict :symbol "arch-modules" :name "Modules" :description "Microkernel module system. External OS processes connect over unix domain sockets, discover themselves via a handshake (core sends empty request, module responds with name + manual), and are registered in the modules map. The send builtin lets logos code call module operations during eval — it serializes requests to JSON, writes to the module socket, reads the response, and records the exchange in the active trace. Modules can also call back to core via the callback socket, which routes through the actor loop to evaluate an on-request handler. Per-module mutex serializes socket reads/writes." :keywords (list "module" "send" "socket" "handshake" "discovery" "callback" "ModuleInfo" "microkernel" "external process" "JSON") :anchors (list anchor-module-info anchor-handle-module-connection anchor-builtin-send anchor-handle-callback) :interactions (list) :see-also (list (link 'arch-core-api) (link 'arch-evaluator) (link 'arch-traces) (link 'arch-types))))

(test arch-modules "has-concept-shape" (let (c arch-modules) (and (not (nil? (get c :symbol))) (not (nil? (get c :name))) (not (nil? (get c :description))) (not (nil? (get c :keywords))) (not (nil? (get c :anchors))) (not (empty? (get c :anchors))))))

(define arch-parser (dict :symbol "arch-parser" :name "Parser" :description "S-expression parser converting text to AST. Parse is the entry point: it creates a parser struct (rune slice + position), dispatches via parseNode to quote/list/string/atom handlers, and produces a tree of Node structs. The parser is simple and stateless — it produces NodeSymbol for identifiers, which are later converted to NodeRef/NodeBuiltin by the graph's resolveAST. Node kinds cover literals (int, float, bool, string, nil, keyword), structure (list), and post-resolution types (ref, builtin)." :keywords (list "parser" "Parse" "AST" "Node" "NodeKind" "S-expression" "parseNode" "atom" "list" "quote" "string" "symbol") :anchors (list anchor-parse anchor-parser-struct anchor-parse-node anchor-node anchor-node-kind) :interactions (list arch-graph-parser-interaction) :see-also (list (link 'arch-evaluator) (link 'arch-types) (link 'lang-syntax))))

(test arch-parser "has-concept-shape" (let (c arch-parser) (and (not (nil? (get c :symbol))) (not (nil? (get c :name))) (not (nil? (get c :description))) (not (nil? (get c :keywords))) (not (nil? (get c :anchors))) (not (empty? (get c :anchors))))))

(define arch-resolve-lines (fn (anchors)
  (if (empty? anchors)
    (list)
    (let (anchor-data (map (fn (a) (dict "file" (get a :file) "scope" (get a :scope) "expected_hash" (get a :hash))) anchors)
          results (send "mod-go" (dict "op" "validate-anchors" "anchors" anchor-data)))
      (loop ((as anchors) (rs results) (acc (list)))
        (if (empty? as)
          (reverse acc)
          (let (a (head as)
                r (head rs)
                line (get r "line"))
            (recur (rest as) (rest rs)
                   (cons (if (nil? line) a (put a :line line)) acc)))))))))

(test arch-resolve-lines "returns-empty-for-empty" (eq (arch-resolve-lines (list)) (list)))

(define arch-describe (fn (node & opts)
  (let (depth (if (empty? opts) :brief (head opts))
        all-anchors (if (not (nil? (get node :members)))
                      (arch-collect-anchors node)
                      (let (own (if (nil? (get node :anchors)) (list) (get node :anchors))
                            int-anchors (if (nil? (get node :interactions)) (list)
                              (fold (fn (acc i) (append acc (if (nil? (get i :anchors)) (list) (get i :anchors)))) (list) (get node :interactions))))
                        (append own int-anchors)))
        resolved (if (empty? all-anchors) (list) (arch-resolve-lines all-anchors))
        line-map (fold (fn (acc a) (let (l (get a :line)) (if (nil? l) acc (put acc (get a :symbol) l)))) (dict) resolved))
    (loop ((stack (list (list node 0))) (acc ""))
      (if (empty? stack)
        acc
        (let (entry (head stack)
              rest-stack (rest stack)
              cur (head entry)
              level (nth entry 1)
              name (get cur :name)
              desc (get cur :description)
              members (get cur :members)
              anchors (get cur :anchors)
              interactions (get cur :interactions)
              see-also (get cur :see-also)
              keywords (get cur :keywords)
              is-root (not (nil? members))
              detail (or (eq depth :full) (gt level 0))
              prefix (if (eq level 0) "## " (if (eq level 1) "### " "#### "))
              sub-prefix (if (eq level 0) "### " (if (eq level 1) "#### " "##### "))
              header (concat prefix name "\n\n" desc "\n")
              kw-sec (if (nil? keywords) ""
                (concat "\n**Keywords**: " (join ", " keywords) "\n"))
              anchor-sec (if (or (nil? anchors) (empty? anchors)) ""
                (if detail
                  (concat "\n" sub-prefix "Anchors\n"
                    (join "\n" (map (fn (a)
                      (let (line (get line-map (get a :symbol))
                            loc (if (nil? line)
                                  (concat (get a :file) ": " (get a :scope))
                                  (concat (get a :file) ":" (to-string line) " " (get a :scope))))
                        (concat "- **" (get a :name) "** (" loc "): " (get a :description))))
                      anchors))
                    "\n")
                  (concat "\n**Anchors**: " (join ", " (map (fn (a) (get a :name)) anchors)) "\n")))
              int-sec (if (or (nil? interactions) (empty? interactions)) ""
                (if detail
                  (concat "\n" sub-prefix "Interactions\n"
                    (join "\n" (map (fn (i)
                      (concat "- **" (get i :name) "**: " (get i :description)))
                      interactions))
                    "\n")
                  (concat "\n**Interactions**: " (join ", " (map (fn (i) (get i :name)) interactions)) "\n")))
              sa-sec (if (or (nil? see-also) (empty? see-also)) ""
                (if detail
                  (concat "\n**See Also**: "
                    (join ", " (map (fn (l) (to-string (link-target l))) see-also))
                    "\n")
                  ""))
              member-sec (if (or (nil? members) (empty? members)) ""
                (if (not detail)
                  (concat "\n" sub-prefix "Members\n"
                    (join "\n" (map (fn (m) (concat "- **" (get m :name) "**: " (get m :description))) members))
                    "\n")
                  ""))
              new-stack (if (and is-root detail)
                (append (map (fn (m) (list m (add level 1))) members) rest-stack)
                rest-stack))
          (recur new-stack
                 (concat acc header kw-sec
                   member-sec anchor-sec int-sec sa-sec "\n"))))))))

(test arch-describe "is-fn" (fn? arch-describe))

(define arch-step-debugger (dict :symbol "arch-step-debugger" :name "Step Debugger" :description "Serialization layer atop the frame-based evaluator enabling single-step execution. builtinStepEval parses an expression and returns the initial evalState as a logos map. builtinStepContinue deserializes a state map, runs one evalStep, and re-serializes the result. The serialization layer (frameToValue/valueToFrame, evalStateToValue/valueToEvalState) handles all 14 frame kinds with their variant-specific fields. Frame bindings are reconnected to shared scope maps after deserialization to maintain the evaluator's invariant. State maps expose :status (:evaluating/:returning/:done/:error) for external inspection." :keywords (list "step" "debugger" "step-eval" "step-continue" "serialize" "deserialize" "frame" "evalState" "suspend" "resume" "single-step") :anchors (list anchor-builtin-step-eval anchor-builtin-step-continue anchor-frame-to-value anchor-value-to-frame anchor-eval-state-to-value anchor-value-to-eval-state) :interactions (list arch-eval-step-debugger-interaction) :see-also (list (link 'arch-evaluator) (link 'arch-parser) (link 'arch-core-api) (link 'lang-builtin-step-eval))))

(test arch-step-debugger "has-concept-shape" (let (c arch-step-debugger) (and (not (nil? (get c :symbol))) (not (nil? (get c :name))) (not (nil? (get c :description))) (not (nil? (get c :keywords))) (not (nil? (get c :anchors))) (not (empty? (get c :anchors))))))

(define arch-traces (dict :symbol "arch-traces" :name "Traces" :description "Evaluation boundary snapshots. Each Trace captures entry node, args, module sends (as SendRecords), result/error, and timestamp. Created by Core during external evals (handleEval, callback handlers). The send builtin appends SendRecords to the active trace during eval. AssertError propagates assertion failures with the currentNodeID for attribution. appendTrace enforces a ring buffer cap (maxTraces=1000). ToValue serializes traces for the traces builtin. Traces capture boundaries, not full computation — replay from boundaries reproduces the full eval since the graph is deterministic." :keywords (list "trace" "Trace" "SendRecord" "assert" "AssertError" "boundary" "snapshot" "module send" "ring buffer" "appendTrace" "replay") :anchors (list anchor-trace anchor-send-record anchor-assert-error anchor-trace-to-value anchor-append-trace) :interactions (list) :see-also (list (link 'arch-evaluator) (link 'arch-modules) (link 'arch-core-api))))

(test arch-traces "has-concept-shape" (let (c arch-traces) (and (not (nil? (get c :symbol))) (not (nil? (get c :name))) (not (nil? (get c :description))) (not (nil? (get c :keywords))) (not (nil? (get c :anchors))) (not (empty? (get c :anchors))))))

(define arch-types (dict :symbol "arch-types" :name "Types" :description "Runtime value representation: a single tagged-union struct (Value) with a Kind discriminant and type-specific fields. 14 kinds cover primitives (int, float, bool, string, keyword, nil), references (symbol, node-ref, link), collections (list, map), and callables (fn, form, builtin). FnValue holds function metadata including closure (a snapshot of the enclosing scope). Truthy implements nil-as-flow: nil and false are falsy. ValuesEqual provides deep recursive equality. ValueToGo/GoToValue handle JSON serialization with type-tagged prefixes for non-JSON types." :keywords (list "Value" "ValueKind" "type" "tagged union" "FnValue" "closure" "Truthy" "equality" "JSON" "serialization" "ValueToGo" "GoToValue") :anchors (list anchor-value anchor-value-kind anchor-fn-value anchor-truthy anchor-values-equal anchor-value-to-go anchor-go-to-value) :interactions (list arch-eval-types-interaction) :see-also (list (link 'arch-parser) (link 'arch-modules) (link 'lang-types))))

(test arch-types "has-concept-shape" (let (c arch-types) (and (not (nil? (get c :symbol))) (not (nil? (get c :name))) (not (nil? (get c :description))) (not (nil? (get c :keywords))) (not (nil? (get c :anchors))) (not (empty? (get c :anchors))))))

(define arch (dict :symbol "arch" :name "Logos Architecture Reference" :description "Architecture documentation for the logos v3 runtime. Each concept node describes a subsystem with code anchors validated against the source via mod-go. Interaction nodes document how subsystems connect, with their own anchors at boundary points. Sub-concept nodes add detail within a subsystem. Cross-references to the lang library link implementation to language semantics." :members (list arch-evaluator arch-graph arch-parser arch-types arch-core-api arch-modules arch-libraries arch-step-debugger arch-traces arch-mcp)))

(test arch "has-root-shape" (let (r arch) (and (not (nil? (get r :symbol))) (not (nil? (get r :name))) (not (nil? (get r :description))) (not (nil? (get r :members))) (not (empty? (get r :members))))))

(define arch-search (fn (query & opts)
  (let (depth (if (empty? opts) 1 (head opts))
        raw (loop ((stack (list (list arch "" "")))
                   (acc (list)))
              (if (empty? stack)
                acc
                (let (entry (head stack)
                      rest-stack (rest stack)
                      cur (head entry)
                      path (nth entry 1)
                      parent-name (nth entry 2)
                      name (get cur :name)
                      current-path (if (eq path "") name (concat path " > " name))
                      is-match (lang-search-matches? cur query)
                      file (get cur :file)
                      is-anchor (not (nil? file))
                      own-result (if is-match
                        (list (let (base (dict :name name :symbol (get cur :symbol) :path current-path)
                                    r1 (if (ge depth 1) (put base :description (get cur :description)) base)
                                    r2 (if (and (ge depth 1) is-anchor) (put (put (put r1 :file file) :scope (get cur :scope)) :hash (get cur :hash)) r1)
                                    r3 (if (and (ge depth 2) (not is-anchor)) (if (not (nil? (get cur :keywords))) (put r2 :keywords (get cur :keywords)) r2) r2))
                               r3))
                        (list))
                      anchors (if (nil? (get cur :anchors)) (list) (get cur :anchors))
                      interactions (if (nil? (get cur :interactions)) (list) (get cur :interactions))
                      members (if (nil? (get cur :members)) (list) (get cur :members))
                      sub-concepts (if (nil? (get cur :sub-concepts)) (list) (get cur :sub-concepts))
                      children (fold (fn (a b) (append a b)) (list)
                        (list members sub-concepts interactions anchors))
                      child-entries (map (fn (c) (list c current-path name)) children))
                  (recur (append child-entries rest-stack)
                         (append acc own-result)))))
        deduped (loop ((items raw) (seen (list)) (acc (list)))
                  (if (empty? items)
                    (reverse acc)
                    (let (item (head items)
                          sym (get item :symbol))
                      (if (member? seen sym)
                        (recur (rest items) seen acc)
                        (recur (rest items) (cons sym seen) (cons item acc))))))
        anchor-results (filter (fn (r) (not (nil? (get r :file)))) deduped))
    (if (empty? anchor-results)
      deduped
      (let (resolved (arch-resolve-lines anchor-results)
            line-map (fold (fn (acc a) (put acc (get a :symbol) (get a :line))) (dict) resolved))
        (map (fn (r)
          (let (line (get line-map (get r :symbol)))
            (if (nil? line) r (put r :line line))))
          deduped))))))

(test arch-search "is-fn" (fn? arch-search))

(define arch-validate (fn (root)
  (let (raw-anchors (arch-collect-anchors root)
        anchors (loop ((as raw-anchors) (acc (list)) (seen (list)))
                  (if (empty? as)
                    (reverse acc)
                    (let (a (head as)
                          sym (get a :symbol))
                      (if (member? seen sym)
                        (recur (rest as) acc seen)
                        (recur (rest as) (cons a acc) (cons sym seen))))))
        anchor-data (map (fn (a) (dict "file" (get a :file) "scope" (get a :scope) "expected_hash" (get a :hash))) anchors)
        results (send "mod-go" (dict "op" "validate-anchors" "anchors" anchor-data))
        paired (loop ((as anchors) (rs results) (acc (list)))
                 (if (empty? as)
                   (reverse acc)
                   (let (a (head as)
                         r (head rs)
                         status (get r "status"))
                     (recur (rest as) (rest rs)
                            (cons (dict :symbol (get a :symbol) :file (get a :file) :scope (get a :scope) :status status :current-hash (if (eq status "changed") (get r "current_hash") nil)) acc)))))
        valid (filter (fn (p) (eq (get p :status) "valid")) paired)
        changed (filter (fn (p) (eq (get p :status) "changed")) paired)
        not-found (filter (fn (p) (eq (get p :status) "not_found")) paired))
    (dict :total (len paired) :valid (len valid) :changed (len changed) :not-found (len not-found) :details (append changed not-found)))))

(test arch-validate "is-fn" (fn? arch-validate))

