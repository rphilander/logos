(define garden-inspect (fn (item) (let (name (get item :name) status (to-string (get item :status)) tags (join ", " (map to-string (get item :tags))) desc (get item :description) effort (get item :effort) blocked-by (get item :blocked-by) outcome (get item :outcome) see-also (get item :see-also) header (concat "### " name "\n**Status**: " status " | **Tags**: " tags "\n") effort-line (if (nil? effort) "" (concat "**Effort**: " (to-string effort) "\n")) desc-line (concat "\n" desc "\n") blocked-sec (if (or (nil? blocked-by) (empty? blocked-by)) "" (concat "\n**Blocked by**:\n" (join "\n" (map (fn (dep) (concat "- " (to-string (get dep :item)) ": " (get dep :reason))) blocked-by)) "\n")) outcome-sec (if (nil? outcome) "" (concat "\n**Outcome**: " outcome "\n")) sa-sec (if (or (nil? see-also) (empty? see-also)) "" (concat "\n**See also**: " (join ", " (map to-string see-also)) "\n"))) (concat header effort-line desc-line blocked-sec outcome-sec sa-sec))))

