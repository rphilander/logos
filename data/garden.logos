(define garden-builtin-anchors (dict :symbol "garden-builtin-anchors" :name "Builtin source anchors in arch" :description "Add an arch sub-concept under arch-evaluator that maps each builtin to its Go implementation anchor. Covers data builtins (eval.go), graph builtins (graph.go), and core-bound builtins (core.go). Bridges the gap between lang (what builtins do) and arch (where they live in Go)." :status :seed :tags (list :arch) :see-also (list (link 'garden-sub-concept-layer))))

(test garden-builtin-anchors "has-garden-item-shape" (garden-item-shape? garden-builtin-anchors))

(define garden-concurrency (dict :symbol "garden-concurrency" :name "Concurrency" :description "Make the graph safe for concurrent access. Go goroutines/channels as substrate. Required for agents, schedulers, concurrent HTTP handlers. Immutable node design helps." :status :seed :tags (list :core)))

(test garden-concurrency "has-garden-item-shape" (garden-item-shape? garden-concurrency))

(define garden-constrained-subagents (dict :symbol "garden-constrained-subagents" :name "Constrained subagents" :description "Spin up subagents with a reduced scope: fewer tools, access to specific libraries only, bespoke tools defined for the task. Lets us delegate tedious mechanical work (batch migrations, test authoring, validation sweeps) without burning primary context or risking off-trail damage. The constraint model is the safety mechanism — instead of safeguarding a powerful macro language, give a simple agent a narrow set of things it can do." :status :seed :tags (list :dx :core) :blocked-by (list (dict :item (link 'garden-http-client-module) :reason "Subagents need to call an LLM API")) :see-also (list (link 'garden-graph-macro-language) (link 'garden-subagent-leverage) (link 'garden-bespoke-chat-ui))))

(test garden-constrained-subagents "has-garden-item-shape" (garden-item-shape? garden-constrained-subagents))

