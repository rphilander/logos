(define garden-bespoke-chat-ui (dict :symbol "garden-bespoke-chat-ui" :name "Bespoke AI chat interfaces" :description "Web-based chat UIs specialized for specific workflows. Nicer layout, colors, and domain-specific presentation than a generic terminal. Examples: garden scrubbing with visual item cards, arch exploration with diagrams, roadmap planning with drag-and-drop. Built on mod-http-server + web library, backed by an LLM API." :status :seed :tags (list :apps :core)))

