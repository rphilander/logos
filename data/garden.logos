(define garden-graph-branching (dict :symbol "garden-graph-branching" :name "Graph branching and merging" :description "Fork the graph into an isolated branch for a subagent to work in. The subagent defines, refines, and deletes symbols in its branch without affecting the main graph. When done, review and merge changes back — like git but for the symbol graph. Enables background work (e.g. a subagent categorizing HN stories into a technews library) that stays invisible until explicitly merged. Immutable nodes make diff/merge natural — each branch is just a divergent set of node IDs." :status :seed :tags (list :core) :see-also (list (link 'garden-constrained-subagents) (link 'garden-concurrency) (link 'garden-atomic-multi-define))))

(test garden-graph-branching "has-garden-item-shape" (garden-item-shape? garden-graph-branching))

(define garden-graph-macro-language (dict :symbol "garden-graph-macro-language" :name "Graph operation macro language" :description "Instead of ever-growing MCP verbs, a reduced macro language the LLM can use to specify compound graph operations. Batch defines, conditional updates, predicate-based transforms. Key concern: one mistake could create or destroy many nodes. Needs safeguards — dry-run preview, transaction boundaries, undo, confirmation thresholds for destructive ops." :status :seed :tags (list :core :mcp) :blocked-by (list (dict :item (link 'garden-atomic-multi-define) :reason "Transactions with rollback needed before compound operations are safe")) :see-also (list (link 'garden-constrained-subagents))))

(test garden-graph-macro-language "has-garden-item-shape" (garden-item-shape? garden-graph-macro-language))

