(define anchor-mcp-main (dict :symbol "anchor-mcp-main" :name "MCP main" :file "mcp-logos/main.go" :scope "main" :hash "sha256:2d04aa946c04229ba139d69a5e4739924fc551e69b0336cffa25f28f9e2a1642" :commit "ab1fb73" :description "Entry point and MCP tool registration. Each tool is registered via s.AddTool with name, description, parameters, and handler function."))

(define anchor-mod-fs-dispatch (dict :symbol "anchor-mod-fs-dispatch" :name "mod-fs dispatch" :file "mod-fs/main.go" :scope "dispatch" :hash "sha256:93fc76365d22ea839630ef166a2cb132aad30426f607e23b192c79e0279d11aa" :commit "ab1fb73" :description "Canonical module dispatch loop. Reads requests, switches on op (empty op returns module name + manual), calls handlers, writes responses."))

(define anchor-mod-fs-main (dict :symbol "anchor-mod-fs-main" :name "mod-fs main" :file "mod-fs/main.go" :scope "main" :hash "sha256:8dad48408363191af2825f5b5a15b6a26a832dd4025479c12b8070387c662649" :commit "ab1fb73" :description "Canonical module entry point. Reads LOGOS_MOD_SOCK (and optionally LOGOS_PROJECT_ROOT), dials the module socket, calls dispatch."))

(define anchor-graph-builtins (dict :symbol "anchor-graph-builtins" :name "graphBuiltins" :file "core/graph.go" :scope "Graph.graphBuiltins" :hash "sha256:590bf6758d1f3bb112000202c5deabc1be6cb952c72ea743a455941473ac067f" :commit "ab1fb73" :description "Returns the graph-introspection builtins map (symbols, node-expr, ref-by, follow). Merged into the evaluator's builtins during NewGraph."))

(define anchor-new-core (dict :symbol "anchor-new-core" :name "NewCore" :file "core/core.go" :scope "NewCore" :hash "sha256:10ee6b07bd1a930e99dd5be447892876273444a5ed7fe2ff1ea1aabdaf0af43c" :commit "ab1fb73" :description "Core constructor. Creates DataBuiltins, adds core-bound builtins (modules, send, traces), passes the merged map to NewGraph."))

(define anchor-append-log-to-owner (dict :symbol "anchor-append-log-to-owner" :name "appendLogToOwner" :file "core/graph.go" :scope "Graph.appendLogToOwner" :hash "sha256:6a32022529f53194a06f79bcf2bd1895324096c7d21c7765928a911b2879296c" :commit "ab1fb73" :description "Writes a log entry to the file that owns a given symbol. Handles cross-library writes when the active log differs from the symbol's owner."))

(define guide-add-core-op (dict :symbol "guide-add-core-op" :name "Adding a Core Op" :description "How to add a new operation to the logos core request/response API, exposed as an MCP tool. This is the most common extension pattern — every op added since the initial build (source, promote, set-fuel, get-fuel) followed these same four steps. The result is a new op accessible via the CLI socket and as an MCP tool for Claude Code." :keywords (list "core op" "handler" "dispatch" "handleRequest" "MCP tool" "AddTool" "extension") :steps (list (dict :title "Write the handler method" :description "Add a method on Core with signature func (c *Core) handleX(id string, msg map[string]any) map[string]any. Extract parameters from msg with type assertions, validate them, perform the operation (often delegating to a Graph method), and return a response map with id, ok, and value keys. On error, return errorResponse(id, msg). See handleEval for the canonical pattern." :anchors (list anchor-handle-eval anchor-core)) (dict :title "Add dispatch case" :description "Add a case to the switch statement in handleRequest: case \"your-op\": resp = c.handleX(id, msg). The op string becomes the wire-protocol operation name that clients send." :anchors (list anchor-handle-request)) (dict :title "Write the MCP handler" :description "Add a function in mcp-logos/main.go with signature func handleX(ctx context.Context, request mcp.CallToolRequest) (*mcp.CallToolResult, error). Extract parameters via request.RequireString, request.GetInt, etc. Build a request dict with an \"op\" field matching the dispatch case. Call send(req) to forward to core, then return formatResult(resp)." :anchors (list anchor-mcp-send anchor-mcp-format-result)) (dict :title "Register the MCP tool" :description "Add s.AddTool(mcp.NewTool(\"logos_x\", ...), handleX) in the main function. Use mcp.WithDescription for the tool description, mcp.WithString/WithNumber/WithBoolean/WithArray for parameters, and mcp.Required() for required params. The tool name convention is logos_ followed by the op name with underscores." :anchors (list anchor-mcp-main))) :see-also (list (link 'arch-core-api) (link 'arch-mcp))))

(define guide-add-module (dict :symbol "guide-add-module" :name "Adding a Module" :description "How to add a new external module to logos. Modules are standalone Go binaries that connect to core over a unix domain socket, following a length-prefixed JSON protocol. Each module provides domain-specific operations (filesystem, git, SQLite, etc.) that logos functions invoke via the send builtin. This pattern has been used for all 7 existing modules: mod-time, mod-http-server, mod-sqlite, mod-mcp-server, mod-fs, mod-git, mod-go." :keywords (list "module" "mod" "socket" "LOGOS_MOD_SOCK" "binary" "dispatch" "protocol" "send" "Procfile" "Makefile") :steps (list (dict :title "Create the module directory" :description "Create mod-x/ at the project root. Run go mod init inside it. Create main.go. The module is a single-file Go binary — all code goes in main.go (package main)." :anchors (list)) (dict :title "Implement wire protocol helpers" :description "Copy readMsg and writeMsg functions. These are identical in every module: 4-byte big-endian length prefix + JSON body over a net.Conn. Every module duplicates them since modules are independent binaries with no shared library." :anchors (list)) (dict :title "Write op handlers and dispatch" :description "Write handler functions with signature func handleX(req map[string]any) (any, string) — returning a value and an error string (empty on success). Write a dispatch function that loops reading requests, switches on the op field, and writes responses. The empty-op case must return the module name and manual string. Add a const manual string documenting all operations with example requests and responses." :anchors (list anchor-mod-fs-dispatch)) (dict :title "Write the main function" :description "Read LOGOS_MOD_SOCK from env (default /tmp/logos-mod.sock). Dial the unix socket. Call dispatch(conn). If the module needs filesystem access, also read LOGOS_PROJECT_ROOT. If it needs to call back to core, read LOGOS_CB_SOCK and dial a second connection. The core side handles the handshake: it sends an ID, the module responds with name + manual on the first empty-op request." :anchors (list anchor-mod-fs-main anchor-handle-module-connection)) (dict :title "Register in build infrastructure" :description "Three files to update: (1) Makefile — add to BINS list, add directory to fmt line, add a build target like mod-x/mod-x: mod-x/*.go with cd mod-x && go build -o mod-x . (2) Procfile — add entry with sleep 1 delay for core startup, env vars (LOGOS_MOD_SOCK, optionally LOGOS_PROJECT_ROOT and LOGOS_CB_SOCK), and binary path. (3) .gitignore — add mod-x/mod-x to exclude the compiled binary." :anchors (list))) :see-also (list (link 'arch-modules) (link 'arch-core-api))))

(define guide-add-builtin (dict :symbol "guide-add-builtin" :name "Adding a Builtin" :description "How to add a new builtin function to the logos evaluator. There are three variants depending on what state the builtin needs access to: (1) Data builtins are pure functions in eval.go, registered in DataBuiltins. (2) Graph builtins need the symbol table, defined as Graph methods and registered in graphBuiltins. (3) Core-bound builtins need Core state (modules, traces), defined as Core methods and registered in NewCore. All share the same signature: func(args []Value) (Value, error). All are eagerly evaluated — arguments are resolved before the builtin runs." :keywords (list "builtin" "DataBuiltins" "graphBuiltins" "NewCore" "Builtin" "eager" "function" "eval") :steps (list (dict :title "Write the builtin function" :description "Write a function with signature func builtinX(args []Value) (Value, error) for data builtins, or func (g *Graph) builtinX(args []Value) (Value, error) for graph builtins, or func (c *Core) builtinX(args []Value) (Value, error) for core-bound builtins. Validate arity and argument types early. Return errors with the builtin name prefix (e.g. \"myop: expected 2 args\"). Use Value constructors (StringVal, ListVal, MapVal, IntVal, FloatVal, BoolVal) for return values." :anchors (list anchor-builtin-send anchor-data-builtins)) (dict :title "Register in the appropriate map" :description "For data builtins: add an entry to the map returned by DataBuiltins() in eval.go. For graph builtins: add to the map returned by graphBuiltins() in graph.go. For core-bound builtins: add builtins[\"name\"] = c.builtinX in NewCore() in core.go, after the DataBuiltins() call. The key string becomes the builtin's name in logos (e.g. \"send\", \"symbols\")." :anchors (list anchor-data-builtins anchor-graph-builtins anchor-new-core)) (dict :title "Add tests" :description "Add test cases in the appropriate _test.go file. Data builtins: core/eval_test.go. Graph builtins: core/graph_test.go. Use table-driven tests with TestEval or similar patterns. Test both success cases and expected error conditions (wrong arity, wrong types)." :anchors (list)) (dict :title "Update documentation" :description "Add the builtin to the lang library reference if applicable (lang-builtin-x node with tests and examples). Update MEMORY.md Builtins section. The builtin becomes available in logos immediately after core restart — no MCP changes needed since builtins are invoked via eval, not as separate ops." :anchors (list))) :see-also (list (link 'arch-evaluator) (link 'arch-core-api) (link 'arch-types))))

(define guide-add-graph-method (dict :symbol "guide-add-graph-method" :name "Adding a Graph Method" :description "How to add a new method to the Graph struct that mutates symbol state. Graph methods are the implementation layer beneath core ops — when a core handler needs to create, modify, or query symbols, it delegates to a Graph method. Key concerns: ownership checking (symbolOwner maps symbols to their owning library), log persistence (appendLog/appendLogToOwner), error recovery (restore state on failure), and the activeLib context (determines which library receives writes). Most graph methods are exposed via a core op, so this guide often precedes guide-add-core-op." :keywords (list "Graph" "method" "symbolOwner" "ownership" "appendLog" "appendLogToOwner" "activeLib" "log" "persistence" "mutation") :steps (list (dict :title "Design the method signature" :description "Graph methods that mutate state follow the pattern func (g *Graph) MethodName(params) (result, error). Choose params carefully — the method should receive already-validated data, not raw request maps (that's the core handler's job). Return the created/modified object for the handler to format into a response." :anchors (list anchor-graph)) (dict :title "Check symbol ownership" :description "If the method operates on an existing symbol, verify ownership via g.symbolOwner[name]. A symbol owned by library X can only be modified when g.activeLib == X. Session symbols have owner \"\". Failing to check ownership lets library symbols be modified from the wrong context. See Define for the canonical ownership guard." :anchors (list anchor-define)) (dict :title "Implement the operation with error recovery" :description "Perform the mutation (modify g.symbols, g.nodes, g.symbolOwner, etc.). If the operation involves multiple steps, restore state on partial failure. Promote is the best example: it temporarily removes ownership, opens a library, defines, closes — and restores ownership if any step fails." :anchors (list)) (dict :title "Persist to the log" :description "After successful mutation, append a log entry via g.appendLog (writes to the active log file) or g.appendLogToOwner (writes to the file that owns the symbol, even if it differs from the active log). Log entries are S-expressions: (define name expr) or (delete name). The log must be kept consistent with in-memory state — if the log write fails, consider whether to roll back." :anchors (list anchor-append-log anchor-append-log-to-owner)) (dict :title "Expose via a core handler" :description "Most graph methods need a corresponding core op. Follow guide-add-core-op: write a handleX method on Core that validates request params, calls the graph method, and formats the result. The graph method stays focused on graph logic; the handler handles wire format." :anchors (list anchor-handle-request))) :see-also (list (link 'arch-graph) (link 'arch-libraries) (link 'guide-add-core-op))))

(define guides (dict :symbol "guides" :name "Logos How-To Guides" :description "Procedural guides for extending the logos runtime. Each guide documents a recurring implementation pattern as an ordered sequence of steps, with each step referencing code anchors validated against the source via mod-go. Peer to the arch library — arch documents what exists, guides document how to extend it." :members (list guide-add-core-op guide-add-module guide-add-builtin guide-add-graph-method)))

(define guide-collect-anchors (fn (root) (let (members (if (nil? (get root :members)) (list root) (get root :members)) all-steps (fold (fn (acc g) (append acc (if (nil? (get g :steps)) (list) (get g :steps)))) (list) members) all-anchors (fold (fn (acc s) (append acc (if (nil? (get s :anchors)) (list) (get s :anchors)))) (list) all-steps)) (loop ((as all-anchors) (acc (list)) (seen (list))) (if (empty? as) (reverse acc) (let (anc (head as) sym (get anc :symbol)) (if (member? seen sym) (recur (rest as) acc seen) (recur (rest as) (cons anc acc) (cons sym seen)))))))))

(define guide-validate (fn (root) (let (anchors (guide-collect-anchors root) anchor-data (map (fn (a) (dict "file" (get a :file) "scope" (get a :scope) "expected_hash" (get a :hash))) anchors) results (send "mod-go" (dict "op" "validate-anchors" "anchors" anchor-data)) paired (loop ((as anchors) (rs results) (acc (list))) (if (empty? as) (reverse acc) (let (a (head as) r (head rs) status (get r "status")) (recur (rest as) (rest rs) (cons (dict :symbol (get a :symbol) :file (get a :file) :scope (get a :scope) :status status :current-hash (if (eq status "changed") (get r "current_hash") nil)) acc))))) valid (filter (fn (p) (eq (get p :status) "valid")) paired) changed (filter (fn (p) (eq (get p :status) "changed")) paired) not-found (filter (fn (p) (eq (get p :status) "not_found")) paired)) (dict :total (len paired) :valid (len valid) :changed (len changed) :not-found (len not-found) :details (append changed not-found)))))

(define guide-describe-one (fn (node detail) (let (name (get node :name) desc (get node :description) steps (get node :steps) keywords (get node :keywords) see-also (get node :see-also)) (let (header (concat "### " name "\n\n" desc "\n") kw-sec (if (nil? keywords) "" (concat "\n**Keywords**: " (join ", " keywords) "\n")) step-sec (concat "\n#### Steps\n" (loop ((ss steps) (i 1) (acc "")) (if (empty? ss) acc (let (s (head ss) title (get s :title) sdesc (get s :description) anchors (if (nil? (get s :anchors)) (list) (get s :anchors)) anchor-info (if (or (not detail) (empty? anchors)) "" (concat " — _" (join ", " (map (fn (a) (concat (get a :name) " (" (get a :file) ": " (get a :scope) ")")) anchors)) "_"))) (recur (rest ss) (add i 1) (concat acc (to-string i) ". **" title "**" (if detail (concat "\n   " sdesc anchor-info "\n") "") "\n")))))) sa-sec (if (or (not detail) (or (nil? see-also) (empty? see-also))) "" (concat "\n**See Also**: " (join ", " (map (fn (l) (to-string (link-target l))) see-also)) "\n"))) (concat header kw-sec step-sec sa-sec)))))

(define guide-describe (fn (node & opts) (let (depth (if (empty? opts) :brief (head opts)) detail (eq depth :full) members (get node :members) is-root (not (nil? members))) (if is-root (if detail (concat "## " (get node :name) "\n\n" (get node :description) "\n\n" (loop ((gs members) (acc "")) (if (empty? gs) acc (recur (rest gs) (concat acc (guide-describe-one (head gs) true) "\n"))))) (concat "## " (get node :name) "\n\n" (get node :description) "\n\n### Guides\n" (join "\n" (map (fn (m) (concat "- **" (get m :name) "**: " (get m :description))) members)) "\n")) (guide-describe-one node detail)))))

(define guide-step-matches? (fn (step query) (let (title (get step :title) desc (get step :description) in-title (if (nil? title) false (contains? title query)) in-desc (if (nil? desc) false (contains? desc query))) (or in-title in-desc))))

(define guide-search (fn (query & opts) (let (depth (if (empty? opts) 1 (head opts)) members (if (nil? (get guides :members)) (list) (get guides :members)) root-path (get guides :name)) (loop ((gs members) (acc (list))) (if (empty? gs) acc (let (g (head gs) gname (get g :name) gpath (concat root-path " > " gname) g-match (if (lang-search-matches? g query) (list (let (base (dict :name gname :symbol (get g :symbol) :path gpath :type :guide) r1 (if (ge depth 1) (put base :description (get g :description)) base) r2 (if (ge depth 2) (if (not (nil? (get g :keywords))) (put r1 :keywords (get g :keywords)) r1) r1)) r2)) (list)) step-matches (loop ((ss (if (nil? (get g :steps)) (list) (get g :steps))) (i 1) (sacc (list))) (if (empty? ss) (reverse sacc) (let (s (head ss) spath (concat gpath " > Step " (to-string i))) (if (guide-step-matches? s query) (let (base (dict :name (get s :title) :path spath :type :step) r1 (if (ge depth 1) (put base :description (get s :description)) base)) (recur (rest ss) (add i 1) (cons r1 sacc))) (recur (rest ss) (add i 1) sacc)))))) (recur (rest gs) (append acc (append g-match step-matches)))))))))
